# SourceBridge environment configuration
# Copy this file to `.env.local` and fill in your key. `.env.local` is gitignored.

# Google Gemini API key -- get one free at https://aistudio.google.com/apikey
# Read ONLY on the server. It is never sent to the browser.
GEMINI_API_KEY=

# Primary model. Model availability changes over time; if you see a "no longer
# available" error, set this to a current model name.
GEMINI_MODEL=gemini-flash-lite-latest

# Optional. Comma-separated models tried when the primary is overloaded.
# Free-tier capacity fluctuates, so rotating recovers faster than waiting.
# Defaults to: gemini-3.1-flash-lite,gemini-3.5-flash-lite,gemini-3.6-flash
# GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-3.5-flash-lite,gemini-3.6-flash

# Optional. Absolute path to ffmpeg, used by the rendered MP4 export.
# Leave unset to use ffmpeg from PATH. Without ffmpeg the app still offers the
# video package (.zip); only the rendered .mp4 is unavailable.
# FFMPEG_PATH=C:/path/to/ffmpeg.exe
