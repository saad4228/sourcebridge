# SourceBridge environment configuration
# Copy this file to `.env.local` and fill in your key. `.env.local` is gitignored.

# At least one provider key is required. Both are free.
#
# With only GROQ_API_KEY the app generates every format but cannot read an
# image or video source, and cannot speak video narration: those need Gemini.
# With only GEMINI_API_KEY everything works, more slowly.

# Google Gemini API key -- get one free at https://aistudio.google.com/apikey
# Read ONLY on the server. It is never sent to the browser.
GEMINI_API_KEY=

# Groq API key -- get one free at https://console.groq.com/keys
# Tried before Gemini for text, because it answers in about a second where the
# Gemini free tier was measured taking tens of seconds, and because its
# allowance is separate: a spent Gemini quota no longer stops the app.
GROQ_API_KEY=

# Primary model. Model availability changes over time; if you see a "no longer
# available" error, set this to a current model name.
GEMINI_MODEL=gemini-3.6-flash

# Optional. Comma-separated models tried when the primary is overloaded.
# Free-tier capacity fluctuates, so rotating recovers faster than waiting.
# Defaults to: gemini-3.5-flash,gemma-4-26b-a4b-it,gemma-4-31b-it,gemini-3.8-flash,
#              gemini-flash-lite-latest,gemini-3.1-flash-lite
# The Gemma entries matter: they draw on a separate allowance, so they keep the
# app working after the Gemini daily quotas are spent.
# GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemma-4-26b-a4b-it,gemma-4-31b-it

# ---------------------------------------------------------------------------
# Optional: the OpenAI-compatible provider
# ---------------------------------------------------------------------------

# Any OpenAI-compatible endpoint works here -- OpenRouter, Cerebras and GitHub
# Models all speak the same shape. Point these at one to switch provider
# without a code change.
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# GROQ_LABEL=Groq

# Comma-separated models, tried in order.
# Defaults to: openai/gpt-oss-120b,openai/gpt-oss-20b,qwen/qwen3.8-27b
# GROQ_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b,qwen/qwen3.8-27b

# Hidden reasoning budget, where the model supports it: low, medium or high.
# Reasoning tokens count against the per-minute allowance, and low was measured
# using about half the tokens for the same output quality. Defaults to low.
# GROQ_REASONING_EFFORT=low

# How long a stated rate-limit delay may be before the app stops waiting it out
# and moves to another model instead. Defaults to 12000.
# PROVIDER_RATE_LIMIT_WAIT_MS=12000

# Optional. Absolute path to ffmpeg, used by the rendered MP4 export.
# Leave unset to use ffmpeg from PATH. Without ffmpeg the app still offers the
# video package (.zip); only the rendered .mp4 is unavailable.
# FFMPEG_PATH=C:/path/to/ffmpeg.exe
